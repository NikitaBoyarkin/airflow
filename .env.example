# Демо-конфигурация docker compose. Скопировать в .env (gitignored) и менять при необходимости.
# Реальных секретов здесь нет: значения ниже — только для локального демо.

# Postgres-источник. 5434 — порт демо-БД из локального сценария (README:83).
# Если локальный Postgres уже слушает 5434, порт контейнера занят: поднять
# значение (например 5435) — compose-сервис airflow не зависит от этого порта,
# он ходит в postgres:5432 по имени сервиса.
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airflow_demo

# UI Airflow: 8080 — Trino, 8081 — личный инстанс, берём 8082 (README:108).
AIRFLOW_PORT=8082

# UID, под которым работает контейнер. Для записи CSV в bind-mount ./data
# поставьте домашний: `echo "AIRFLOW_UID=$(id -u)" >> .env`.
AIRFLOW_UID=50000

# Google Sheets (нужны только при output="sheets"; демо работает на output="file").
# GOOGLE_CLOUD_PROJECT=
# AIRFLOW_CONN_GOOGLE_CLOUD_DEFAULT='{"conn_type": "google-cloud-platform", "extra": {"keyfile_dict": "..."}}'
# AIRFLOW_VAR_AIRFLOW_CFG_SALES_REPORT_SPREADSHEET_ID=
